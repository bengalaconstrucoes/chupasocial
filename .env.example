# ChupaSocial — variáveis de ambiente
#
# Projeto Supabase > Settings > API
# Apenas chaves PÚBLICAS vão para o app. A service_role nunca é usada no cliente
# nem no servidor da aplicação (toda escrita passa por RLS com a sessão do usuário).

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Usada apenas por scripts locais de teste (nunca versionar o valor real).
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_TEST_PASSWORD=""
